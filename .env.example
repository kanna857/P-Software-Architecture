# AI Software Architect 2.0 Environment Configuration

# LLM Providers (At least one is required)
OPENAI_API_KEY=your_openai_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here

# Database Configuration
# Leave empty to default to SQLite (sqlite:///./architect.db)
DATABASE_URL=sqlite:///./architect.db

# Observability (Optional)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Safety Limits
MAX_AGENT_CALLS=15
MAX_REVIEW_ITERATIONS=3
MAX_TOKEN_BUDGET=500000
